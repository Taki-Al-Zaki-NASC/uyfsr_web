# UYFSR Official Server Environment Configuration
PORT=5000

# ========================================================
# GMAIL AUTOMATION SETTINGS
# ========================================================
# Official Secretariat Email Account:
GMAIL_USER=uyfsr.org@gmail.com

# 16-character Google App Password (leave blank for local outbox simulation)
# To enable real Gmail sending:
# 1. Log in to uyfsr.org@gmail.com
# 2. Enable 2-Step Verification in Google Account -> Security
# 3. Create an "App Password" (name it "UYFSR Web")
# 4. Paste the 16-character generated password below:
GMAIL_APP_PASSWORD=
